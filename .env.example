# Application secrets: file must be chmod 600, owned by ubuntu.
NODE_ENV=production
APP_URL=https://febro.id
HOST=127.0.0.1
PORT=3090
DATA_DIR=/opt/febro/data
COOKIE_SECURE=1

# Hostinger SMTP used for CV requests / approvals and Contact messages
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_STARTTLS=false
SMTP_USER=info@logisourcedigital.web.id
SMTP_PASS=REPLACE_WITH_REAL_MAILBOX_PASSWORD
SMTP_FROM="Febro Herdyanto - LogiSource Digital <info@logisourcedigital.web.id>"
CV_ADMIN_EMAIL=febroherdyanto@outlook.com
CV_LINK_TTL_HOURS=72

# PocketBase read-only public CV sync (optional; only once collection names verified)
CV_SYNC_EXPERIENCE=
CV_SYNC_EDUCATION=
CV_SYNC_CERTIFICATIONS=
